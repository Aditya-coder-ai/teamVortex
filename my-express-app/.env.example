PORT=5000
NODE_ENV=development

DATABASE_URL=mongodb://localhost:27017/restaurant_db

# Firebase Admin SDK — Service account key for backend token verification
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key

# Option 1: Point to the downloaded JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Individual credentials (from the service account JSON)
FIREBASE_PROJECT_ID=team-vortex-b7fe2
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@team-vortex-b7fe2.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Staff role security
STAFF_PASSCODE=STAFF2026
